{
  "name": "only-mini-tool",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "gen:types": "cargo run --manifest-path src-tauri/Cargo.toml --bin export-ts",
    "check:fe": "vue-tsc --noEmit",
    "check:types": "npm run gen:types && git diff --exit-code -- src/api/generated",
    "check:version": "node scripts/bump-version.mjs --check",
    "bump": "node scripts/bump-version.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "vue": "^3.5.13",
    "vue-i18n": "^11.1.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vue-tsc": "^2.1.10"
  }
}
